# --- NestJS API (server/src) ---
# Get these from Supabase: Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# In production, restrict CORS to your deployed frontend origin.
# Leave unset locally — it falls back to allowing any origin.
ALLOWED_ORIGIN=https://pyramid-workspace.vercel.app

# --- AI assistant (optional — /api/chat). Get a free key at console.groq.com ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Next.js frontend (app/) ---
# Base URL of the NestJS API above. Locally this is the default; in
# production, set it to your deployed Nest URL (e.g. Render).
NEXT_PUBLIC_API_URL=http://localhost:4000
